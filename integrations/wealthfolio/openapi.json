    "/api/wheelhouse/v1/workspace": {
      "get": {
        "summary": "Workspace",
        "operationId": "workspace_api_wheelhouse_v1_workspace_get",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "fixture",
                "binance"
              ],
              "type": "string",
              "default": "fixture",
              "title": "Source"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTCUSDT",
              "title": "Symbol"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "5m",
                "15m",
                "1h",
                "4h",
                "1d"
              ],
              "type": "string",
              "default": "1h",
              "title": "Timeframe"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
